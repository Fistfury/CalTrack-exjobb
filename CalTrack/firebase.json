{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  },

  "functions": {
    "source": "functions",
    "ignore": ["node_modules", ".git", "firebase-debug.log"],
    "includedFiles": ["src/config/serviceAccountKey.json"]
  }
}
