rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      // Allow read and update only for the authenticated user with matching userId
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // Allow create for any authenticated user
      allow create: if request.auth != null;
      // Delete operations are not allowed
    }

    // Entries collection
    match /entries/{entryId} {
      // Allow read and write only if the authenticated user's UID matches the entry's userId
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
